datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  phone         String?
  emailOptOut   Boolean        @default(false)
  smsOptOut     Boolean        @default(false)
  whatsappOptOut Boolean       @default(false)
  cases         RecoveryCase[]
  createdAt     DateTime       @default(now())
}

model RecoveryCase {
  id                    String        @id @default(uuid())
  customerId            String
  customer              Customer      @relation(fields: [customerId], references: [id])
  type                  String        // Clean category: "payment_failure", "subscription_failure", "checkout_abandonment", "invoice_overdue"
  amount                Float
  status                String        @default("OPEN") // "OPEN", "RECOVERED", "CLOSED_NO_RECOVERY", "ESCALATED"
  riskReason            String        // Raw reason from webhook: e.g., "Insufficient funds"
  subReason             String?       // Classifier output: "insufficient_funds", "card_expired", "upi_cap_exceeded", "unknown_reason"
  attemptCount          Int           @default(0)
  lastContactedAt       DateTime?
  lastObservedAt        DateTime?     // Phase 8: Timestamp of last autonomous observation
  observationOutcome    String?       // Phase 8: "RECOVERED", "STILL_OPEN", "ACTION_FAILED", "MAX_ATTEMPTS_REACHED", "WAITING", "TERMINAL"
  lockedForProcessing   Boolean       @default(false)
  razorpayPaymentLinkId String?       // Stores real Razorpay link ID when created
  actions               AgentAction[]
  messages              MessageLog[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model AgentAction {
  id             String       @id @default(uuid())
  caseId         String
  case           RecoveryCase @relation(fields: [caseId], references: [id])
  actionType     String       // "EVENT_CLASSIFIED", "AI_DECISION", "SAFETY_CHECK", "TOOL_EXECUTED", "OBSERVATION"
  aiReasoning    String       // e.g., "Customer needs time to top up account"
  status         String       // "SUCCESS", "FAILED", "BLOCKED"
  metadata       String?      // JSON string for tool/observation-specific result data
  timestamp      DateTime     @default(now())
}

model MessageLog {
  id                String       @id @default(uuid())
  caseId            String
  case              RecoveryCase @relation(fields: [caseId], references: [id])
  channel           String       // "EMAIL", "SMS", "WHATSAPP"
  provider          String       // "SENDGRID", "TWILIO_SMS", "TWILIO_WHATSAPP", "SIMULATED"
  providerMessageId String?      // Message SID or SendGrid ID
  recipient         String       // Email address or Phone number
  subject           String?
  bodyText          String
  deliveryStatus    String       @default("QUEUED") // "QUEUED", "SENT", "DELIVERED", "FAILED", "BOUNCED"
  errorDetails      String?
  sentAt            DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

