PORT=3001
DATABASE_URL="file:./dev.db"

# API Keys (Keep Backend-Only — NEVER expose to frontend/Vite)
GROQ_API_KEY=your_groq_api_key_here
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Agent Cooldown & Scheduler Config (Demo defaults: 2 mins / 30 secs. Production would use 24 hours / 1 hour)
COOLDOWN_MS=120000
CHECK_INTERVAL_MS=30000
